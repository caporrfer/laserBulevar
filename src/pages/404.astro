---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArrowIcon from '@/components/ArrowIcon.astro';
---

<BaseLayout title="Página no encontrada | Láser Bulevar" description="La página que buscas no existe.">
  <section class="not-found container">
    <p class="eyebrow">Error 404</p>
    <h1>Esta página<br /><em>se ha ido.</em></h1>
    <a class="button button-plum" href="/">Volver al inicio <ArrowIcon /></a>
  </section>
</BaseLayout>

