---
interface Props {
  direction?: 'up-right' | 'down';
}

const { direction = 'up-right' } = Astro.props;
---

<svg class:list={['arrow-icon', `arrow-icon-${direction}`]} aria-hidden="true" viewBox="0 0 24 24" fill="none">
  {direction === 'down' ? (
    <path d="M12 4v16M5 13l7 7 7-7" />
  ) : (
    <path d="M5 19 19 5M9 5h10v10" />
  )}
</svg>
