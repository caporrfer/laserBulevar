---
import { business, defaultWhatsappMessage, whatsappLink } from '@/config/business';

const pathname = Astro.url.pathname;
const links = [
  { href: '/depilacion-laser/', label: 'Depilación láser' },
  { href: '/tratamientos-faciales/', label: 'Facial' },
  { href: '/tratamientos-corporales/', label: 'Corporal' },
  { href: '/el-centro/', label: 'El centro' },
  { href: '/contacto/', label: 'Contacto' },
];
---

<header class="site-header" data-header>
  <a class="brand" href="/" aria-label={`${business.name}, inicio`}>
    <span>Láser Bulevar</span>
    <small>Jaén</small>
  </a>

  <nav class="desktop-nav" aria-label="Navegación principal">
    {links.map((link) => (
      <a href={link.href} aria-current={pathname === link.href ? 'page' : undefined}>{link.label}</a>
    ))}
  </nav>

  <a class="header-cta" href={whatsappLink(defaultWhatsappMessage)} target="_blank" rel="noreferrer">
    Pide cita <span aria-hidden="true">↗</span>
  </a>

  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu">
    <span class="sr-only">Abrir menú</span>
    <span></span><span></span>
  </button>

  <nav class="mobile-menu" id="mobile-menu" aria-label="Navegación móvil" hidden>
    {links.map((link, index) => (
      <a href={link.href} aria-current={pathname === link.href ? 'page' : undefined}>
        <span>0{index + 1}</span>{link.label}
      </a>
    ))}
    <a class="mobile-menu-cta" href={whatsappLink(defaultWhatsappMessage)} target="_blank" rel="noreferrer">
      WhatsApp <span aria-hidden="true">↗</span>
    </a>
  </nav>
</header>

<script>
  const header = document.querySelector('[data-header]');
  const toggle = header?.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = header?.querySelector<HTMLElement>('.mobile-menu');

  const closeMenu = () => {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', 'false');
    toggle.querySelector('.sr-only')!.textContent = 'Abrir menú';
    menu.hidden = true;
    document.body.classList.remove('menu-open');
  };

  toggle?.addEventListener('click', () => {
    if (!menu) return;
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    toggle.querySelector('.sr-only')!.textContent = open ? 'Abrir menú' : 'Cerrar menú';
    menu.hidden = open;
    document.body.classList.toggle('menu-open', !open);
  });

  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
  window.addEventListener('keydown', (event) => event.key === 'Escape' && closeMenu());
</script>
