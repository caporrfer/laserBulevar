---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { illustrativePriceNotice, whatsappLink } from '@/config/business';
import { services, type Service } from '@/content/services';
import ArrowIcon from '@/components/ArrowIcon.astro';

interface Props {
  service: Service;
}

const { service } = Astro.props;
const otherServices = services.filter((item) => item.slug !== service.slug);
---

<BaseLayout title={`${service.title} | Láser Bulevar`} description={service.description}>
  <section class="service-hero">
    <div class="service-hero-media">
      <Image
        src={service.image}
        alt={service.imageAlt}
        widths={[480, 768, 1100, 1500]}
        sizes="(max-width: 899px) 100vw, 56vw"
        loading="eager"
        fetchpriority="high"
        quality={84}
      />
    </div>
    <div class="service-hero-copy">
      <p class="eyebrow eyebrow-light" data-hero-kicker>{service.eyebrow}</p>
      <h1 class="service-display" data-hero-title>
        {service.statement.split(' ').map((word) => <span><i>{word}&nbsp;</i></span>)}
      </h1>
      <div class="service-hero-bottom" data-hero-actions>
        <p>{service.intro}</p>
        <a
          class="button button-coral"
          href={whatsappLink(service.message)}
          target="_blank"
          rel="noreferrer"
        >
          Consultar por WhatsApp <ArrowIcon />
        </a>
      </div>
    </div>
  </section>

  <section class="service-intro section container">
    <div data-reveal>
      <p class="eyebrow">{service.title}</p>
      <h2>Lo esencial,<br /><em>bien cuidado.</em></h2>
    </div>
    <div class="service-intro-copy" data-reveal>
      <p>{service.description}</p>
      <ul>
        {service.points.map((point, index) => (
          <li><span>0{index + 1}</span>{point}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="single-price section">
    <div class="container price-stage" data-reveal>
      <p class="eyebrow eyebrow-light">Precio orientativo</p>
      <div class="price-lockup">
        <span>Desde</span>
        <strong>{service.price}€</strong>
        <span>{service.unit}</span>
      </div>
      <p class="price-notice price-notice-light">{illustrativePriceNotice}</p>
    </div>
  </section>

  <section class="faq-section section container">
    <div class="faq-heading" data-reveal>
      <p class="eyebrow">Antes de venir</p>
      <h2>Preguntas<br /><em>frecuentes.</em></h2>
    </div>
    <div class="faq-list" data-reveal>
      {service.questions.map((item, index) => (
        <details>
          <summary>
            <span>0{index + 1}</span>
            {item.question}
            <i aria-hidden="true"></i>
          </summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="more-services section container">
    <p class="eyebrow" data-reveal>También en Láser Bulevar</p>
    <div class="more-grid">
      {otherServices.map((item, index) => (
        <a class="more-card" href={`/${item.slug}/`} data-reveal>
          <span>0{index + 1}</span>
          <h2>{item.shortTitle}</h2>
          <ArrowIcon />
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

