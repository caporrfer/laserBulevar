---
import { Image } from 'astro:assets';
import type { Service } from '@/content/services';
import BaseLayout from '@/layouts/BaseLayout.astro';
import FaqList from '@/components/FaqList.astro';
import ContactPanel from '@/components/ContactPanel.astro';
import { whatsappLink } from '@/config/business';

interface Props { service: Service }
const { service } = Astro.props;
---

<BaseLayout title={service.title} description={service.description}>
  <section class="service-hero">
    <div class="service-hero-copy reveal">
      <p class="eyebrow">{service.eyebrow}</p>
      <h1>{service.shortTitle}</h1>
      <p>{service.intro}</p>
      <a class="button button-primary" href={whatsappLink(service.message)} target="_blank" rel="noreferrer">Consultar por WhatsApp <span aria-hidden="true">↗</span></a>
    </div>
    <figure class="service-hero-media reveal reveal-delay">
      <Image src={service.image} alt={service.imageAlt} widths={[540, 760, 1080]} sizes="(max-width: 767px) 100vw, 50vw" format="webp" quality={86} loading="eager" />
      <figcaption>Imagen editorial</figcaption>
    </figure>
  </section>

  <section class="statement-section section-pad animate-on-scroll">
    <p class="eyebrow">A tu ritmo</p>
    <h2>{service.statement}</h2>
  </section>

  <section class="steps-section animate-on-scroll" aria-label="Cómo informarte">
    {service.highlights.map((item) => (
      <article>
        <span>{item.number}</span>
        <h2>{item.title}</h2>
        <p>{item.text}</p>
      </article>
    ))}
  </section>

  <FaqList items={service.questions} />
  <ContactPanel message={service.message} />
</BaseLayout>
